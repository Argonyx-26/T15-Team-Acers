# OpenWeather API key: https://home.openweathermap.org/api_keys
EXPO_PUBLIC_OPENWEATHER_API_KEY=replace_with_openweather_key

# Optional second OpenWeather key reserved for agro telemetry integrations.
EXPO_PUBLIC_AGRO_OPENWEATHER_API_KEY=replace_with_agro_openweather_key

# URL for the trained native TFLite model. Keep this empty until the artifact is ready.
EXPO_PUBLIC_TFLITE_MODEL_URL=